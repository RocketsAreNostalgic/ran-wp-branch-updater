includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 8
	phpVersion: 80200
	treatPhpDocTypesAsCertain: false
	paths:
		- .
	# Repository-root development and dependency roles only; never match nested product directories.
	excludePaths:
		analyseAndScan:
			- tests/*
			- scripts/*
			- vendor/*
			- node_modules/*
			- .git/*
