includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	# Start below level 6 so standards adoption does not redefine the package's
	# existing public array contracts merely to satisfy missing iterable-value
	# annotations. Raising this baseline should be a separate typed-contract change.
	level: 5
	treatPhpDocTypesAsCertain: false
	paths:
		- src
