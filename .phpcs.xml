<?xml version="1.0"?>
<ruleset name="RAN WP Branch Updater Coding Standards">
	<description>Shared RAN WordPress-library coding and PHP compatibility baseline for the branch updater.</description>

	<config name="testVersion" value="8.2-"/>

	<!-- PHPCS governs the shipped library surface; syntax and contract tests cover fixtures/scripts separately. -->
	<file>src</file>
	<file>bootstrap.php</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<rule ref="RANWordPressLibrary"/>

	<!-- #59: all shipped owned declarations are audited and checked, including connected contracts. -->
	<rule ref="RANOwnedMethods"/>
	<!-- All shipped variables are audited; only declaration-local external contracts are excepted. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName"/>

	<!-- RANOwnedMethods covers all declarations, including classes upstream skips. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ran_wp_branch_updater"/>
				<element value="RAN\WPBranchUpdater\V1"/>
			</property>
		</properties>
	</rule>

</ruleset>
