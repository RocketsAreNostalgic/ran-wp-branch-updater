<?xml version="1.0"?>
<ruleset name="RAN WP Branch Updater Coding Standards">
	<description>Shared RAN WordPress-library coding and PHP compatibility baseline for the branch updater.</description>

	<config name="testVersion" value="8.2-"/>

	<!-- PHPCS governs the shipped library surface; syntax and contract tests cover fixtures/scripts separately. -->
	<file>src</file>
	<file>bootstrap.php</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<rule ref="RANWordPressLibrary"/>

	<!-- #59: all owned methods are checked; remaining connected declarations have line-specific deferrals. -->
	<rule ref="RANOwnedMethods"/>
	<!-- Fully audited variable scopes. Connected parameter/property use remains in #59 / Core #167. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<include-pattern>/bootstrap.php</include-pattern>
		<include-pattern>/src/Archive/PackageSubdirectory.php</include-pattern>
		<include-pattern>/src/Archive/PreparedArchiveArtifact.php</include-pattern>
		<include-pattern>/src/Contract/AdmittedArchiveSource.php</include-pattern>
		<include-pattern>/src/Contract/AdmittedAttemptJournal.php</include-pattern>
		<include-pattern>/src/Contract/AdmittedBranchArtifact.php</include-pattern>
		<include-pattern>/src/Contract/AdmittedPackageExecutor.php</include-pattern>
		<include-pattern>/src/Contract/BranchProvider.php</include-pattern>
		<include-pattern>/src/Contract/MutationLock.php</include-pattern>
		<include-pattern>/src/Contract/PackageExecutor.php</include-pattern>
		<include-pattern>/src/Contract/PreparedPackageArtifact.php</include-pattern>
		<include-pattern>/src/Persistence/BranchDeploymentJournalFailure.php</include-pattern>
		<include-pattern>/src/Persistence/FileAttemptJournal.php</include-pattern>
		<include-pattern>/src/Persistence/FileMutationLock.php</include-pattern>
		<include-pattern>/src/Runtime/AdmittedBranchDurabilityFailure.php</include-pattern>
		<include-pattern>/src/Runtime/BranchDeploymentLockReleaseFailure.php</include-pattern>
		<include-pattern>/src/Runtime/BranchDeploymentLockStorageFailure.php</include-pattern>
		<include-pattern>/src/Runtime/CorePackageExecutionFailure.php</include-pattern>
		<include-pattern>/src/Runtime/CorePackageExecutionResult.php</include-pattern>
		<include-pattern>/src/Runtime/StandalonePackageExecutor.php</include-pattern>
		<include-pattern>/src/WordPress/InstalledPackageIdentifier.php</include-pattern>
		<include-pattern>/src/WordPress/WordPressUpdaterLock.php</include-pattern>
	</rule>

	<!-- RANOwnedMethods covers all declarations, including classes upstream skips. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ran_wp_branch_updater"/>
				<element value="RAN\WPBranchUpdater\V1"/>
			</property>
		</properties>
	</rule>

</ruleset>
