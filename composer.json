{
  "name": "ran/wp-branch-updater",
  "description": "Explicit branch ZIP deployment for WordPress plugins and themes.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2",
    "ext-hash": "*",
    "ext-json": "*",
    "ext-zip": "*",
    "ran/updater-support": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "RAN\\WPBranchUpdater\\V1\\": "src/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/Support/"
    ]
  },
  "support": {
    "issues": "https://github.com/RocketsAreNostalgic/ran-wp-branch-updater/issues",
    "security": "https://github.com/RocketsAreNostalgic/ran-wp-branch-updater/security/advisories/new",
    "source": "https://github.com/RocketsAreNostalgic/ran-wp-branch-updater"
  },
  "scripts": {
    "test:contract": "@php tests/contract.php",
    "test:architecture": "@php tests/architecture-normalisation-baseline.php",
    "test:archive": "@php tests/archive-normalisation-baseline.php",
    "test:runner": "@php tests/admitted-runner.php",
    "test:hard-stop": "@php tests/hard-stop.php",
    "test:journal": "@php tests/journal-invariants.php",
    "test:identifier": "@php tests/installed-package-identifier.php",
    "test:error-code": "@php tests/core-package-error-code.php",
    "lint": "find src tests scripts -type f -name '*.php' -print0 | xargs -0 -n1 php -l && php -l bootstrap.php",
    "check": [
      "@validate:strict",
      "@test:contract",
      "@test:architecture",
      "@test:archive",
      "@test:runner",
      "@test:hard-stop",
      "@test:journal",
      "@test:identifier",
      "@test:error-code",
      "@test:release-publisher",
      "@lint"
    ],
    "validate:strict": "composer validate --strict --no-check-publish",
    "test:release-publisher": "node --test tests/release-publisher-decision.test.mjs tests/release-publisher.test.mjs tests/release-publisher-version.test.mjs"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/RocketsAreNostalgic/ran-updater-support"
    }
  ]
}
